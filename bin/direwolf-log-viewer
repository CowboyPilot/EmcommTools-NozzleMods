#!/bin/bash
# Real-time DireWolf log viewer
# Tails the systemd journal for all DireWolf services and AIOC modes

echo "════════════════════════════════════════════════════════════"
echo "  DireWolf Log Viewer"
echo "════════════════════════════════════════════════════════════"
echo ""
echo "Watching: et-service-direwolf-* + aioc-direwolf (systemd journal)"
echo "Press Ctrl-C to exit"
echo "════════════════════════════════════════════════════════════"
echo ""

journalctl --user \
  -u et-service-direwolf-simple \
  -u et-service-direwolf-9600 \
  -u et-service-direwolf-300 \
  -u et-service-direwolf-aprs-digipeater \
  -u et-service-direwolf-packet-digipeater \
  -t aioc-direwolf \
  -n 100 -f
