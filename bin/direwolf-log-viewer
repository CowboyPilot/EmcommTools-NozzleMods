#!/bin/bash
# Real-time DireWolf log viewer
# Tails the systemd journal for all DireWolf services and AIOC modes

echo "════════════════════════════════════════════════════════════"
echo "  DireWolf Log Viewer"
echo "════════════════════════════════════════════════════════════"
echo ""
echo "Watching: et-service-direwolf-* + aioc-direwolf (systemd journal)"
echo "Press Ctrl-C to exit"
echo "════════════════════════════════════════════════════════════"
echo ""

# '+' is the OR separator in journalctl field matching
journalctl --user -n 100 -f \
  _SYSTEMD_USER_UNIT=et-service-direwolf-simple.service + \
  _SYSTEMD_USER_UNIT=et-service-direwolf-9600.service + \
  _SYSTEMD_USER_UNIT=et-service-direwolf-300.service + \
  _SYSTEMD_USER_UNIT=et-service-direwolf-aprs-digipeater.service + \
  _SYSTEMD_USER_UNIT=et-service-direwolf-packet-digipeater.service + \
  SYSLOG_IDENTIFIER=aioc-direwolf
