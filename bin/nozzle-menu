################################################################################
# Update Function
################################################################################

update_nozzle_tools() {
  clear
  echo -e "${GREEN}================================================================${NC}"
  echo -e "${GREEN}           Update NozzleMods Tools${NC}"
  echo -e "${GREEN}================================================================${NC}"
  echo
  echo "This will download and run the latest installer from GitHub."
  echo "All tools will be updated to the latest versions."
  echo
  read -r -p "Continue with update? (y/N): " update_choice

  if [[ "${update_choice}" =~ ^[Yy]$ ]]; then
    echo
    echo "Downloading latest installer..."

    local temp_installer="/tmp/nozzle-install-update.sh"

    if curl -fsSL "https://raw.githubusercontent.com/CowboyPilot/EmcommTools-NozzleMods/main/install.sh" -o "${temp_installer}"; then
      chmod +x "${temp_installer}"
      echo
      echo "Running installer..."
      echo
      bash "${temp_installer}"
      rm -f "${temp_installer}"
      echo
      echo -e "${GREEN}Update complete!${NC}"
      echo
      read -r -p "Press Enter to exit (restart nozzle-menu to use updated version)..."
      exit 0
    else
      echo -e "${RED}Failed to download installer${NC}"
      echo
      read -r -p "Press Enter to return to menu..."
    fi
  fi
}

################################################################################
# Menu Functions
################################################################################

show_aioc_menu() {
  while true; do
    clear
    echo -e "${GREEN}================================================================${NC}"
    echo -e "${GREEN}           AIOC Options${NC}"
    echo -e "${GREEN}================================================================${NC}"
    echo ""
    echo "DireWolf Only:"
    echo ""
    echo "  1) Simple TNC (start DireWolf only)"
    echo "  2) Packet Digipeater"
    echo "  3) APRS Digipeater"
    echo ""
    echo "Applications (starts DireWolf + app):"
    echo ""
    echo "  4) APRS Client (YAAC)"
    echo "  5) BBS Client (Paracon)"
    echo "  6) BBS Client (QtTermTCP)"
    echo "  7) BBS Server (LinBPQ)"
    echo "  8) Chat (chattervox)"
    echo "  9) Winlink Packet"
    echo ""
    echo -e "${BLUE}DireWolf-only modes: use alsamixer to adjust volumes.${NC}"
    echo -e "${RED}Leave the window open until you are done then Ctrl-C to close.${NC}"
    echo ""
    echo "  B) Back to Main Menu"
    echo ""
    echo -n "Enter choice: "

    read -r CHOICE
    CHOICE=$(echo "$CHOICE" | tr '[:lower:]' '[:upper:]')

    case "${CHOICE}" in
      1)
        launch_aioc_mode "aioc-simple" "Simple TNC"
        ;;
      2)
        launch_aioc_mode "aioc-packet" "Packet Digipeater"
        ;;
      3)
        launch_aioc_mode "aioc-aprs" "APRS Digipeater"
        ;;
      4)
        launch_aioc_app_mode "APRS Client (YAAC)" "et-yaac start"
        ;;
      5)
        launch_aioc_app_mode "BBS Client (Paracon)" "et-paracon start"
        ;;
      6)
        launch_aioc_app_mode "BBS Client (QtTermTCP)" "et-qttermtcp start"
        ;;
      7)
        launch_aioc_app_mode "BBS Server (LinBPQ)" "et-bbs-server start"
        ;;
      8)
        launch_aioc_app_mode "Chat (chattervox)" "et-chattervox start"
        ;;
      9)
        launch_aioc_winlink_packet
        ;;
      B)
        return
        ;;
      *)
        echo -e "${RED}Invalid choice${NC}"
        sleep 2
        ;;
    esac
  done
}

show_radio_menu() {
  while true; do
    clear
    echo -e "${GREEN}================================================================${NC}"
    echo -e "${GREEN}           Install Options${NC}"
    echo -e "${GREEN}================================================================${NC}"
    echo ""
    echo "  1) Configure Xiegu G90 DigiRig PTT"
    echo "  2) Install Yaesu FT-710 Support"
    echo "  3) Install Anytone 578 Support"
    echo "  4) Install Custom Hamlib (Anytone 578 driver)"
    echo "  5) Install Mercury Modem"
    echo "  6) Install AIOC Support"
    echo ""
    echo "  B) Back to Main Menu"
    echo ""
    echo -n "Enter choice: "

    read -r CHOICE
    CHOICE=$(echo "$CHOICE" | tr '[:lower:]' '[:upper:]')

    case "${CHOICE}" in
      1)
        configure_xiegu_g90
        ;;
      2)
        install_yaesu_ft710
        ;;
      3)
        install_anytone578
        ;;
      4)
        install_hamlib_anytone
        ;;
      5)
        install_mercury
        ;;
      6)
        install_aioc
        ;;
      B)
        return
        ;;
      *)
        echo -e "${RED}Invalid choice${NC}"
        sleep 2
        ;;
    esac
  done
}

show_system_menu() {
  while true; do
    clear
    echo -e "${GREEN}================================================================${NC}"
    echo -e "${GREEN}           System Tools Menu${NC}"
    echo -e "${GREEN}================================================================${NC}"
    echo ""
    echo "  1) Fix APT Repository Sources"
    echo "  2) Update NozzleMods Tools"
    echo ""
    echo "  B) Back to Main Menu"
    echo ""
    echo -n "Enter choice: "

    read -r CHOICE
    CHOICE=$(echo "$CHOICE" | tr '[:lower:]' '[:upper:]')

    case "${CHOICE}" in
      1)
        fix_apt_sources
        ;;
      2)
        update_nozzle_tools
        ;;
      B)
        return
        ;;
      *)
        echo -e "${RED}Invalid choice${NC}"
        sleep 2
        ;;
    esac
  done
}

show_menu() {
  clear
  echo -e "${GREEN}================================================================${NC}"
  echo -e "${GREEN}           NozzleMods Menu - EmComm Tools R6${NC}"
  echo -e "${GREEN}================================================================${NC}"
  echo ""
  echo "VARA Applications:"
  echo ""
  echo "  1) Pat + VARA HF"
  echo "  2) Pat + VARA FM"
  echo "  3) VARA HF Modem Only"
  echo "  4) VARA FM Modem Only"
  echo ""
  echo "Mercury Modem:"
  echo ""
  echo "  5) Mercury Standalone"
  echo "  6) Pat + Mercury"
  echo ""
  echo -e "${YELLOW}════════════════════════════════════════════════════════════${NC}"
  echo ""
  echo "  A) AIOC Options"
  echo "  R) Install Options"
  echo "  S) System Tools"
  echo ""
  echo -e "${YELLOW}════════════════════════════════════════════════════════════${NC}"
  echo ""
  echo "  Q) Quit"
  echo ""
  echo -n "Enter choice: "
}

################################################################################
# Main
################################################################################

main() {
  while true; do
    show_menu
    read -r CHOICE

    # Convert to uppercase for letter choices
    CHOICE=$(echo "$CHOICE" | tr '[:lower:]' '[:upper:]')

    case "${CHOICE}" in
      1)
        # Pat + VARA HF
        global_cleanup

        echo
        echo -e "${BLUE}Selected: Pat + VARA HF${NC}"

        PORT=$(find_free_port) || {
          echo -e "${RED}ERROR: No free port found in 8300-8350${NC}"
          sleep 3
          continue
        }
        echo -e "${GREEN}Using TCP port: ${PORT}${NC}"

        echo
        echo "Updating configuration files..."
        patch_vara_ini_port "HF" "${PORT}"
        configure_pat "HF" "${PORT}"

        echo
        start_vara_hf
        start_pat

        echo
        echo -e "${GREEN}================================================================${NC}"
        echo -e "${GREEN}  Launch complete - Pat + VARA HF${NC}"
        echo -e "${GREEN}================================================================${NC}"
        echo
        read -r -p "Press Enter to return to menu..."
        ;;

      2)
        # Pat + VARA FM
        global_cleanup

        echo
        echo -e "${BLUE}Selected: Pat + VARA FM${NC}"

        PORT=$(find_free_port) || {
          echo -e "${RED}ERROR: No free port found in 8300-8350${NC}"
          sleep 3
          continue
        }
        echo -e "${GREEN}Using TCP port: ${PORT}${NC}"

        echo
        echo "Updating configuration files..."
        patch_vara_ini_port "FM" "${PORT}"
        configure_pat "FM" "${PORT}"

        echo
        start_vara_fm
        start_pat

        echo
        echo -e "${GREEN}================================================================${NC}"
        echo -e "${GREEN}  Launch complete - Pat + VARA FM${NC}"
        echo -e "${GREEN}================================================================${NC}"
        echo
        read -r -p "Press Enter to return to menu..."
        ;;

      3)
        # VARA HF Modem Only
        global_cleanup

        echo
        echo -e "${BLUE}Selected: VARA HF Modem Only${NC}"

        PORT=$(find_free_port) || {
          echo -e "${RED}ERROR: No free port found in 8300-8350${NC}"
          sleep 3
          continue
        }

        echo
        echo "Updating INI files..."
        patch_vara_ini_port "HF" "${PORT}"

        echo
        start_vara_hf

        IP_ADDR=$(get_primary_ip)
        echo
        echo -e "${GREEN}================================================================${NC}"
        echo -e "${GREEN}  VARA HF Modem Only - Ready${NC}"
        echo -e "${GREEN}================================================================${NC}"
        echo -e "${GREEN}  Connect to: ${IP_ADDR}:${PORT}${NC}"
        echo -e "${GREEN}================================================================${NC}"
        echo
        read -r -p "Press Enter to return to menu..."
        ;;

      4)
        # VARA FM Modem Only
        global_cleanup

        echo
        echo -e "${BLUE}Selected: VARA FM Modem Only${NC}"

        PORT=$(find_free_port) || {
          echo -e "${RED}ERROR: No free port found in 8300-8350${NC}"
          sleep 3
          continue
        }

        echo
        echo "Updating INI files..."
        patch_vara_ini_port "FM" "${PORT}"

        echo
        start_vara_fm

        IP_ADDR=$(get_primary_ip)
        echo
        echo -e "${GREEN}================================================================${NC}"
        echo -e "${GREEN}  VARA FM Modem Only - Ready${NC}"
        echo -e "${GREEN}================================================================${NC}"
        echo -e "${GREEN}  Connect to: ${IP_ADDR}:${PORT}${NC}"
        echo -e "${GREEN}================================================================${NC}"
        echo
        read -r -p "Press Enter to return to menu..."
        ;;

      5)
        # Mercury Standalone
        global_cleanup

        echo
        echo -e "${BLUE}Selected: Mercury Standalone${NC}"

        PORT=$(find_free_port) || {
          echo -e "${RED}ERROR: No free port found in 8300-8350${NC}"
          sleep 3
          continue
        }
        echo -e "${GREEN}Using TCP port: ${PORT}${NC}"

        echo
        echo "Updating mercury.ini..."
        patch_mercury_ini_port "${PORT}" || {
          sleep 3
          continue
        }

        echo
        start_mercury || {
          sleep 3
          continue
        }

        show_mercury_info "${PORT}"
        read -r -p "Press Enter to return to menu..."
        ;;

      6)
        # Pat + Mercury
        global_cleanup

        echo
        echo -e "${BLUE}Selected: Pat + Mercury${NC}"

        PORT=$(find_free_port) || {
          echo -e "${RED}ERROR: No free port found in 8300-8350${NC}"
          sleep 3
          continue
        }
        echo -e "${GREEN}Using TCP port: ${PORT}${NC}"

        echo
        echo "Updating configuration files..."
        patch_mercury_ini_port "${PORT}" || {
          sleep 3
          continue
        }
        configure_pat "HF" "${PORT}"

        echo
        start_mercury || {
          sleep 3
          continue
        }
        start_pat

        show_mercury_info "${PORT}"
        read -r -p "Press Enter to return to menu..."
        ;;

      A)
        show_aioc_menu
        ;;

      R)
        show_radio_menu
        ;;

      S)
        show_system_menu
        ;;

      Q)
        echo "Exiting NozzleMods. 73!"
        exit 0
        ;;

      *)
        echo -e "${RED}Invalid choice${NC}"
        sleep 2
        ;;
    esac
  done
}

main
