#!/bin/bash
################################################################################
# nozzle-menu
#
# Main menu for NozzleMods - EmComm Tools R6 enhancements V2.0
#
# Features:
#   - VARA Tools launcher (Pat with VARA HF/FM, standalone VARA modems)
#   - AIOC DireWolf modes (Simple TNC, Packet, APRS)
#   - Install options (Xiegu G90, Yaesu FT-710, Anytone 578, Mercury, AIOC)
#   - System fixes and maintenance
#
################################################################################

set -euo pipefail

# Paths
NOZZLE_DIR="${HOME}/NozzleMods"
ET_HOME="/opt/emcomm-tools"
ET_BIN="${ET_HOME}/bin"
WINEPREFIX="${HOME}/.wine32"

# Wine executables
VARA_HF_EXE="${WINEPREFIX}/drive_c/VARA/VARA.exe"
VARA_FM_EXE="${WINEPREFIX}/drive_c/VARA FM/VARAFM.exe"

# INI files
VARA_HF_INI="${WINEPREFIX}/drive_c/VARA/VARA.ini"
VARA_FM_INI="${WINEPREFIX}/drive_c/VARA FM/VARAFM.ini"

# Colors
RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
NC='\033[0m'

# Wine command
WINE_BIN="$(command -v wine-stable 2>/dev/null || command -v wine 2>/dev/null || echo wine)"

################################################################################
# Sanity Checks
################################################################################

if [[ "${EUID}" -eq 0 ]]; then
  echo -e "${RED}ERROR: Do NOT run this script as root.${NC}"
  exit 1
fi

################################################################################
# Helper Functions
################################################################################

# Find first free port in 8300-8350 (no TCP state at all)
find_free_port() {
  local port
  for port in $(seq 8300 8350); do
    if ! ss -tan 2>/dev/null | grep -q ":${port} "; then
      echo "${port}"
      return 0
    fi
  done
  return 1
}

# Global cleanup: kill ET processes + Wine + VARA
global_cleanup() {
  echo
  echo -e "${YELLOW}=============================================================${NC}"
  echo -e "${YELLOW}  Cleaning up: killing ET / Wine / VARA processes${NC}"
  echo -e "${YELLOW}=============================================================${NC}"

  # Kill ET processes
  if [[ -x "${ET_BIN}/et-kill-all" ]]; then
    "${ET_BIN}/et-kill-all" 2>/dev/null || true
  fi

  # Kill Wine for this prefix
  WINEPREFIX="${WINEPREFIX}" wineserver -k 2>/dev/null || true

  # Kill any leftover VARA / Mercury processes
  pkill -u "$USER" -f "VARA.exe" 2>/dev/null || true
  pkill -u "$USER" -f "VARAFM.exe" 2>/dev/null || true
  pkill -u "$USER" -f "^mercury" 2>/dev/null || true
  pkill -f "pat http" 2>/dev/null || true
  pkill -u "$USER" -f "rigctld" 2>/dev/null || true

  sleep 2
  echo -e "${GREEN}Cleanup complete${NC}"
}

# Get primary IP address
get_primary_ip() {
  local ip
  ip=$(hostname -I 2>/dev/null | awk 'NF{print $1;exit}') || ip=""
  if [[ -z "${ip}" ]]; then
    ip=$(ip -4 addr show scope global 2>/dev/null | awk "/inet /{print \$2}" | cut -d/ -f1 | head -n1) || ip=""
  fi
  echo "${ip:-127.0.0.1}"
}

################################################################################
# Pat Configuration Functions
################################################################################

# Get ET environment variables
get_et_vars() {
  local CALLSIGN=""
  local GRID=""
  local WINLINK_PASSWD=""
  local ET_USER_CONFIG="${HOME}/.config/emcomm-tools/user.json"

  if [ -f "${ET_USER_CONFIG}" ]; then
    CALLSIGN=$(jq -r .callsign "${ET_USER_CONFIG}" 2>/dev/null || echo "")
    GRID=$(jq -r .grid "${ET_USER_CONFIG}" 2>/dev/null || echo "")
    WINLINK_PASSWD=$(jq -r .winlinkPasswd "${ET_USER_CONFIG}" 2>/dev/null || echo "")
  fi

  echo "${CALLSIGN}|${GRID}|${WINLINK_PASSWD}"
}

# Configure Pat for VARA HF or FM
configure_pat() {
  local mode="$1"  # HF or FM
  local port="$2"
  local data_port=$((port + 1))
  local ET_CONF_TEMPLATE_DIR="${ET_HOME}/conf/template.d/winlink"
  local PAT_CONFIG="${HOME}/.config/pat/config.json"

  echo -e "${BLUE}  → Configuring Pat for VARA ${mode}${NC}"

  # Get ET variables
  local et_vars=$(get_et_vars)
  local CALLSIGN=$(echo "$et_vars" | cut -d'|' -f1)
  local GRID=$(echo "$et_vars" | cut -d'|' -f2)
  local WINLINK_PASSWD=$(echo "$et_vars" | cut -d'|' -f3)

  # Check for valid callsign
  if [ -z "$CALLSIGN" ] || [ "$CALLSIGN" = "N0CALL" ] || [ "$CALLSIGN" = "null" ]; then
    echo -e "${RED}  ! ERROR: No valid callsign set${NC}"
    echo -e "${YELLOW}    Run 'et-user' to set your callsign${NC}"
    return 1
  fi

  # Determine template file
  local template_file
  if [[ "${mode}" == "HF" ]]; then
    template_file="${ET_CONF_TEMPLATE_DIR}/config.vara-hf.json"
  else
    template_file="${ET_CONF_TEMPLATE_DIR}/config.vara-fm.json"
  fi

  # Check if template exists
  if [[ ! -f "${template_file}" ]]; then
    echo -e "${RED}  ! ERROR: Pat template not found: ${template_file}${NC}"
    return 1
  fi

  # Create Pat config directory
  mkdir -p "$(dirname "${PAT_CONFIG}")"

  # Copy template
  echo -e "${BLUE}  → Copying template: ${template_file}${NC}"
  cp "${template_file}" "${PAT_CONFIG}"

  # Substitute ET variables using sed (matching et-winlink pattern)
  sed -i "s|{{ET_CALLSIGN}}|${CALLSIGN}|g" "${PAT_CONFIG}"
  sed -i "s|{{ET_WINLINK_PASSWD}}|${WINLINK_PASSWD}|g" "${PAT_CONFIG}"
  sed -i "s|{{ET_GRID}}|${GRID}|g" "${PAT_CONFIG}"

  # Update VARA ports using jq
  if command -v jq &>/dev/null; then
    if [[ "${mode}" == "HF" ]]; then
      jq ".varahf.cmdPort = ${port} | .varahf.dataPort = ${data_port}" "${PAT_CONFIG}" > "${PAT_CONFIG}.tmp" && mv "${PAT_CONFIG}.tmp" "${PAT_CONFIG}"
    else
      jq ".varafm.cmdPort = ${port} | .varafm.dataPort = ${data_port}" "${PAT_CONFIG}" > "${PAT_CONFIG}.tmp" && mv "${PAT_CONFIG}.tmp" "${PAT_CONFIG}"
    fi
    echo -e "${GREEN}  ✓ Pat configured for VARA ${mode} (cmd:${port}, data:${data_port})${NC}"
  else
    echo -e "${YELLOW}  ! WARNING: jq not found, ports not updated${NC}"
  fi
}

# Start Pat HTTP server and open browser
start_pat() {
  if ! command -v pat &>/dev/null; then
    echo -e "${RED}ERROR: 'pat' command not found${NC}"
    echo -e "${YELLOW}Please install Pat Winlink first${NC}"
    return 1
  fi

  echo -e "${GREEN}>>> Starting Pat HTTP server...${NC}"

  # Kill any existing pat http processes
  pkill -f "pat http" 2>/dev/null || true
  sleep 1

  # Start pat http in background
  pat http &>/dev/null &
  sleep 3

  # Open browser
  local pat_url="http://localhost:8080"
  echo -e "${GREEN}>>> Opening browser to ${pat_url}${NC}"

  if command -v xdg-open &>/dev/null; then
    xdg-open "${pat_url}" &>/dev/null &
  elif command -v firefox &>/dev/null; then
    firefox "${pat_url}" &>/dev/null &
  elif command -v chromium-browser &>/dev/null; then
    chromium-browser "${pat_url}" &>/dev/null &
  else
    echo -e "${YELLOW}Could not detect browser. Please open: ${pat_url}${NC}"
  fi
}

################################################################################
# INI Patching Functions
################################################################################

# Patch VARA HF/FM INI with new port
patch_vara_ini_port() {
  local mode="$1"  # HF or FM
  local port="$2"
  local ini=""

  if [[ "${mode}" == "HF" ]]; then
    ini="${VARA_HF_INI}"
  else
    ini="${VARA_FM_INI}"
  fi

  if [[ ! -f "${ini}" ]]; then
    echo -e "${YELLOW}  ! INI file not found: ${ini}${NC}"
    if [[ "${port}" == "8300" ]]; then
      echo -e "${GREEN}  ✓ VARA ${mode} will use default port 8300 on first run${NC}"
      return 0
    else
      echo -e "${YELLOW}  ! WARNING: VARA ${mode} hasn't been run yet${NC}"
      echo -e "${YELLOW}    It will start with default port 8300${NC}"
      echo -e "${YELLOW}    Close VARA ${mode} and restart this launcher to update the port${NC}"
      return 0
    fi
  fi

  echo -e "${BLUE}  → Updating ${ini}${NC}"
  echo -e "${BLUE}     Setting TCP Command Port=${port}${NC}"

  cp "${ini}" "${ini}.backup" 2>/dev/null || true

  sed -i "s/^TCP Command Port=.*/TCP Command Port=${port}/" "${ini}"

  # Verify the change
  local new_port=$(grep "^TCP Command Port=" "${ini}" | cut -d= -f2)
  if [[ "${new_port}" == "${port}" ]]; then
    echo -e "${GREEN}  ✓ Successfully set TCP Command Port=${port}${NC}"
  else
    echo -e "${RED}  ! WARNING: Port may not have been set correctly${NC}"
    echo -e "${YELLOW}    Expected: ${port}, Found: ${new_port}${NC}"
  fi
}

################################################################################
# Launch Functions
################################################################################

start_vara_hf() {
  if [[ ! -e "${VARA_HF_EXE}" ]]; then
    echo -e "${RED}ERROR: VARA HF not found at: ${VARA_HF_EXE}${NC}"
    return 1
  fi

  echo -e "${GREEN}>>> Starting VARA HF...${NC}"
  WINEPREFIX="${WINEPREFIX}" "${WINE_BIN}" "${VARA_HF_EXE}" >/dev/null 2>&1 &
  sleep 3
}

start_vara_fm() {
  if [[ ! -e "${VARA_FM_EXE}" ]]; then
    echo -e "${RED}ERROR: VARA FM not found at: ${VARA_FM_EXE}${NC}"
    return 1
  fi

  echo -e "${GREEN}>>> Starting VARA FM...${NC}"
  WINEPREFIX="${WINEPREFIX}" "${WINE_BIN}" "${VARA_FM_EXE}" >/dev/null 2>&1 &
  sleep 3
}

################################################################################
# Mercury Functions
################################################################################

MERCURY_INI="${HOME}/mercury.ini"
MERCURY_BUILD_DIR="${HOME}/mercury-build"

# Patch mercury.ini ARQ base port
patch_mercury_ini_port() {
  local port="$1"

  if [[ ! -f "${MERCURY_INI}" ]]; then
    echo -e "${YELLOW}  ! mercury.ini not found at ${MERCURY_INI}${NC}"
    echo -e "${YELLOW}    Run 'Install Mercury Modem' from Install Options first${NC}"
    return 1
  fi

  echo -e "${BLUE}  → Updating ${MERCURY_INI}${NC}"
  echo -e "${BLUE}     Setting arq_tcp_base_port = ${port}${NC}"

  cp "${MERCURY_INI}" "${MERCURY_INI}.backup" 2>/dev/null || true
  sed -i "s/^arq_tcp_base_port.*/arq_tcp_base_port = ${port}/" "${MERCURY_INI}"

  local new_port=$(grep "^arq_tcp_base_port" "${MERCURY_INI}" | sed 's/.*= *//')
  if [[ "${new_port}" == "${port}" ]]; then
    echo -e "${GREEN}  ✓ Successfully set arq_tcp_base_port = ${port}${NC}"
  else
    echo -e "${RED}  ! WARNING: Port may not have been set correctly${NC}"
  fi
}

start_mercury() {
  if ! command -v mercury &>/dev/null; then
    echo -e "${RED}ERROR: 'mercury' command not found${NC}"
    echo -e "${YELLOW}Please install Mercury first from Install Options menu${NC}"
    return 1
  fi

  if [[ ! -f "${MERCURY_INI}" ]]; then
    echo -e "${RED}ERROR: mercury.ini not found at ${MERCURY_INI}${NC}"
    echo -e "${YELLOW}Please install Mercury first from Install Options menu${NC}"
    return 1
  fi

  if [[ ! -d "${MERCURY_BUILD_DIR}" ]]; then
    echo -e "${RED}ERROR: Mercury build directory not found at ${MERCURY_BUILD_DIR}${NC}"
    echo -e "${YELLOW}Please install Mercury first from Install Options menu${NC}"
    return 1
  fi

  echo -e "${GREEN}>>> Starting Mercury modem...${NC}"
  cd "${MERCURY_BUILD_DIR}"
  mercury -C "${MERCURY_INI}" &>/dev/null &
  sleep 2
  cd "${HOME}"
}

show_mercury_info() {
  local port="$1"
  local data_port=$((port + 1))

  echo
  echo -e "${GREEN}================================================================${NC}"
  echo -e "${GREEN}  Mercury Web GUI${NC}"
  echo -e "${GREEN}================================================================${NC}"
  echo -e "${BLUE}  http://127.0.0.1:10000${NC}"
  echo
  echo -e "${GREEN}  Use the web GUI to select and adjust your sound card.${NC}"
  echo
  echo -e "${GREEN}  ARQ ports: cmd=${port}, data=${data_port}${NC}"
  echo
  echo -e "${YELLOW}  IMPORTANT: Mercury does not control PTT.${NC}"
  echo -e "${YELLOW}  Your client program (Pat, BPQ, etc.) must be configured${NC}"
  echo -e "${YELLOW}  to handle its own PTT control via rigctld or CAT.${NC}"
  echo
  echo -e "${GREEN}  Mercury is compatible with any program that supports VARA.${NC}"
  echo -e "${GREEN}  Configure the program to connect to Mercury's ARQ ports${NC}"
  echo -e "${GREEN}  (${port}/${data_port}) just as you would with VARA.${NC}"
  echo
}

################################################################################
# AIOC DireWolf Functions
################################################################################

set_aioc_audio_levels() {
  local card
  local aplay_out
  aplay_out=$(arecord -l 2>/dev/null | grep ET_AUDIO) || return 0
  card=$(echo "$aplay_out" | cut -d":" -f1 | awk '{print $2}')

  echo -e "${BLUE}Setting AIOC audio levels to 25%...${NC}"
  amixer -q -c "${card}" sset 'AIOC Audio In' 25% 2>/dev/null || true
  amixer -q -c "${card}" sset 'AIOC Audio In 1' 25% 2>/dev/null || true
  amixer -q -c "${card}" sset 'AIOC Audio Out Vol' 25% 2>/dev/null || true
  echo -e "${GREEN}✓ AIOC audio levels set${NC}"
}

check_aioc() {
  if ! command -v aioc-direwolf &>/dev/null; then
    echo -e "${RED}ERROR: aioc-direwolf command not found${NC}"
    echo -e "${YELLOW}Please install AIOC support first from Install Options menu${NC}"
    echo
    read -r -p "Press Enter to return to menu..."
    return 1
  fi
  return 0
}

launch_aioc_mode() {
  local mode="$1"
  local mode_name="$2"

  clear
  echo -e "${GREEN}================================================================${NC}"
  echo -e "${GREEN}           AIOC DireWolf - ${mode_name}${NC}"
  echo -e "${GREEN}================================================================${NC}"
  echo

  check_aioc || return 1

  set_aioc_audio_levels

  echo -e "${BLUE}Starting AIOC DireWolf in ${mode_name} mode...${NC}"
  echo

  systemd-cat -t aioc-direwolf aioc-direwolf start "${mode}"

  echo
  echo -e "${GREEN}================================================================${NC}"
  echo -e "${GREEN}  AIOC DireWolf ${mode_name} Started${NC}"
  echo -e "${GREEN}================================================================${NC}"
  echo
  read -r -p "Press Enter to return to menu..."
}

start_aioc_direwolf_background() {
  set_aioc_audio_levels

  echo -e "${BLUE}Starting AIOC DireWolf (1200 baud)...${NC}"
  systemd-cat -t aioc-direwolf aioc-direwolf start aioc-simple &
  DIREWOLF_PID=$!

  local elapsed=0
  while ! ss -tln 2>/dev/null | grep -q ":8001 "; do
    sleep 2
    elapsed=$((elapsed + 2))
    if [ ${elapsed} -ge 15 ]; then
      echo -e "${RED}ERROR: DireWolf failed to start (KISS port 8001 not listening)${NC}"
      kill ${DIREWOLF_PID} 2>/dev/null
      return 1
    fi
  done
  echo -e "${GREEN}✓ DireWolf running (PID ${DIREWOLF_PID})${NC}"
}

launch_aioc_app_mode() {
  local mode_name="$1"
  local app_cmd="$2"

  clear
  echo -e "${GREEN}================================================================${NC}"
  echo -e "${GREEN}           AIOC - ${mode_name}${NC}"
  echo -e "${GREEN}================================================================${NC}"
  echo

  check_aioc || return 1

  start_aioc_direwolf_background || {
    read -r -p "Press Enter to return to menu..."
    return 1
  }

  echo
  echo -e "${BLUE}Starting ${mode_name}...${NC}"
  echo

  ${app_cmd}

  echo
  echo -e "${YELLOW}Application exited. Stopping DireWolf...${NC}"
  pkill -u "$USER" -f "direwolf" 2>/dev/null || true
  echo -e "${GREEN}Done.${NC}"
  echo
  read -r -p "Press Enter to return to menu..."
}

launch_aioc_winlink_packet() {
  clear
  echo -e "${GREEN}================================================================${NC}"
  echo -e "${GREEN}           AIOC - Winlink Packet${NC}"
  echo -e "${GREEN}================================================================${NC}"
  echo

  check_aioc || return 1

  start_aioc_direwolf_background || {
    read -r -p "Press Enter to return to menu..."
    return 1
  }

  echo
  echo -e "${BLUE}Starting Pat Winlink in packet mode...${NC}"
  et-winlink start-packet &
  sleep 3

  local pat_url="http://localhost:8080"
  echo -e "${GREEN}Opening browser to ${pat_url}${NC}"
  if command -v xdg-open &>/dev/null; then
    xdg-open "${pat_url}" &>/dev/null &
  elif command -v firefox &>/dev/null; then
    firefox "${pat_url}" &>/dev/null &
  elif command -v chromium-browser &>/dev/null; then
    chromium-browser "${pat_url}" &>/dev/null &
  else
    echo -e "${YELLOW}Could not detect browser. Please open: ${pat_url}${NC}"
  fi

  echo
  echo -e "${GREEN}================================================================${NC}"
  echo -e "${GREEN}  Winlink Packet running on AIOC${NC}"
  echo -e "${GREEN}================================================================${NC}"
  echo -e "${BLUE}  Pat web interface: ${pat_url}${NC}"
  echo
  read -r -p "Press Enter to stop and return to menu..."

  pkill -f "pat http" 2>/dev/null || true
  pkill -u "$USER" -f "direwolf" 2>/dev/null || true
  echo -e "${GREEN}Done.${NC}"
  sleep 1
}

